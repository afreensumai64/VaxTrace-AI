# VaxTrace AI — Environment Variables Template
# Copy to .env and fill in real values. NEVER commit .env to git.
# All services below are FREE with no credit card required.

# ─── Database (Supabase Free Tier — supabase.com) ───────────────────────────
# Get from: Supabase project → Settings → Database → Connection String (Transaction pooler)
DATABASE_URL=postgresql+asyncpg://postgres.xxxx:YOURPASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
SQL_ECHO=false

# ─── JWT Auth (built into FastAPI, zero external deps) ───────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-generate-with-python-secrets-token-hex-32
JWT_EXPIRE_MINUTES=1440

# ─── Firebase Auth (OPTIONAL — only if you use Firebase instead of JWT) ──────
# Uncomment firebase-admin in requirements.txt first, then set this:
# FIREBASE_CREDENTIALS_PATH=./firebase-credentials.json

# ─── API ─────────────────────────────────────────────────────────────────────
# Render.com sets PORT automatically — leave as default here
PORT=10000
